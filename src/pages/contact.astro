---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="聯絡我們 — 文藻小螺絲釘 WUTH">
  <PageHero title="聯絡我們" subtitle="Contact Us" />
  <div class="max-w-4xl mx-auto px-4 py-16">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm text-center">
        <p class="text-3xl mb-3">📍</p>
        <h3 class="font-bold text-gray-800 mb-2">辦公室位置</h3>
        <p class="text-sm text-gray-500 leading-relaxed">文藻外語大學<br/>807 高雄市民族一路 900 號</p>
      </div>
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm text-center">
        <p class="text-3xl mb-3">📞</p>
        <h3 class="font-bold text-gray-800 mb-2">電話聯繫</h3>
        <p class="text-sm text-gray-500">07-342-6031 #6208</p>
        <p class="text-xs text-gray-400 mt-1">週一至週五 9:00–17:00</p>
      </div>
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm text-center">
        <p class="text-3xl mb-3">💬</p>
        <h3 class="font-bold text-gray-800 mb-2">社群媒體</h3>
        <div class="flex justify-center gap-3 mt-3">
          <a href="https://fb.wzuusr.org" target="_blank" rel="noopener" aria-label="Facebook"
            class="w-10 h-10 rounded-full bg-gray-100 hover:bg-gradient-to-br hover:from-[#1a56a0] hover:to-cyan-500 flex items-center justify-center transition-colors group">
            <svg class="w-5 h-5 fill-gray-500 group-hover:fill-white" viewBox="0 0 24 24">
              <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
            </svg>
          </a>
          <a href="https://ig.wzuusr.org" target="_blank" rel="noopener" aria-label="Instagram"
            class="w-10 h-10 rounded-full bg-gray-100 hover:bg-gradient-to-br hover:from-[#1a56a0] hover:to-cyan-500 flex items-center justify-center transition-colors group">
            <svg class="w-5 h-5 stroke-gray-500 group-hover:stroke-white" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-width="2"/>
              <circle cx="12" cy="12" r="4" stroke-width="2"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" class="fill-gray-500 group-hover:fill-white" stroke="none"/>
            </svg>
          </a>
          <a href="https://yt.wzuusr.org" target="_blank" rel="noopener" aria-label="YouTube"
            class="w-10 h-10 rounded-full bg-gray-100 hover:bg-gradient-to-br hover:from-[#1a56a0] hover:to-cyan-500 flex items-center justify-center transition-colors group">
            <svg class="w-5 h-5 fill-gray-500 group-hover:fill-white" viewBox="0 0 24 24">
              <path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Map -->
    <section>
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">交通資訊</h2>
      <div class="rounded-2xl overflow-hidden shadow-sm">
        <iframe
          src="https://www.google.com/maps?q=%E6%96%87%E8%97%BB%E5%A4%96%E8%AA%9E%E5%A4%A7%E5%AD%B8+807%E9%AB%98%E9%9B%84%E5%B8%82%E4%B8%89%E6%B0%91%E5%8D%80%E6%B0%91%E6%97%8F%E4%B8%80%E8%B7%AF900%E8%99%9F&output=embed"
          width="100%" height="350" style="border:0;" allowfullscreen loading="lazy"
          title="文藻外語大學地圖">
        </iframe>
      </div>
      <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
        <div class="bg-gray-50 rounded-xl p-4">
          <p class="font-semibold text-gray-700 mb-1">🚇 捷運</p>
          <p class="text-gray-500">高雄捷運紅線「後驛站」，步行約 10 分鐘。</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4">
          <p class="font-semibold text-gray-700 mb-1">🚌 公車</p>
          <p class="text-gray-500">紅27、紅28、紅29、72、76、77，於「文藻外語大學」站下車。</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4">
          <p class="font-semibold text-gray-700 mb-1">🚗 開車</p>
          <p class="text-gray-500">國道一號高雄交流道下，沿民族路北行約 10 分鐘。校內設有訪客停車場。</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
