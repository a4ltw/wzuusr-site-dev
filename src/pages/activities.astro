---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const events = [
  { date: '114/09/26', title: '場域討論會議', url: 'https://www.facebook.com/share/p/1FKiFfrVXx/' },
  { date: '114/07/27', title: '遊戲與社福的對話', url: 'https://www.facebook.com/share/p/16S6n2E1h5/' },
  { date: '114/07/22', title: '場域夥伴討論會議', url: 'https://www.facebook.com/share/p/1CP6YbrHMD/' },
  { date: '114/07/16', title: '場域討論會議', url: 'https://www.facebook.com/share/p/1EPZYnxA1T/' },
  { date: '114/07/08', title: '文藻 USR + 芥菜種會「華語教學國際場域需求及教材研發」線上討論會', url: 'https://www.facebook.com/share/p/176yw4FRyj/' },
  { date: '114/06/10', title: '教師社群講座——跨文化的呼召：從砂勞越啟程通往南洋', url: 'https://www.facebook.com/share/p/1BEJfeQ6Au/' },
  { date: '114/03/26', title: '國際小螺絲釘線上相見歡', url: 'https://www.facebook.com/share/p/18z3bCo8Xn/' },
  { date: '114/03/22', title: '醫院小螺絲釘教育訓練', url: 'https://www.facebook.com/share/p/1CgZMmazJZ/' },
  { date: '114/03/19', title: '大手牽小手相見歡', url: 'https://www.facebook.com/share/p/17UcNdmssJ/' },
  { date: '114/03/17', title: '社區課程', url: 'https://www.facebook.com/share/p/16awDMtbpS/' },
  { date: '114/03/12', title: '計畫與芥菜種會線上會議', url: 'https://www.facebook.com/share/p/16v1NHsGRQ/' },
  { date: '114/02/13', title: '計畫與芥菜種會線上會議', url: 'https://www.facebook.com/share/p/19oNJFh1i6/' },
  { date: '114/01/14', title: '場域團隊建立', url: 'https://www.facebook.com/share/p/1JHdYHUxfE/' },
];
---
<BaseLayout title="計畫動態 — 文藻小螺絲釘 WUTH">
  <PageHero title="計畫動態" subtitle="Updates & Activities" />
  <div class="max-w-4xl mx-auto px-4 py-16">

    <!-- 計畫衍生之亮點案例 -->
    <section class="mb-14">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-8">計畫衍生之亮點案例</h2>

      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-[#1a56a0] to-blue-400 px-6 py-4">
          <p class="text-white text-xs font-semibold uppercase tracking-widest opacity-80">Highlight Case</p>
          <h3 class="text-white text-lg font-bold mt-1">我是蚵仔寮最佳代言人</h3>
          <p class="text-blue-100 text-sm mt-0.5">從海岸到元宇宙・虛實同行蚵仔寮</p>
        </div>
        <div class="p-6 space-y-4 text-[15px] text-gray-600 leading-relaxed">
          <p>
            以推廣地方文化為目標的動畫作品《我是蚵仔寮最佳代言人》，創作出兩位虛擬偶像，擔綱蚵仔寮的最佳代言人。同時參加第四屆元宇宙虛擬偶像設計大賽，榮獲<strong class="text-gray-800">優選獎</strong>及<strong class="text-gray-800">最佳指導老師獎</strong>。
          </p>
          <p>
            動畫中，虛擬角色「仔仔」與「蚵蚵」從海底出發，潛入現實世界，穿梭於蚵仔寮的信仰中心朝天宮、海岸沙灘。動畫畫面大量採用蚵仔寮實地拍攝素材，搭配虛擬角色的 3D 合成，呈現虛實交錯的敘事魅力。
          </p>
          <p>
            這不僅是一部關於地方特色介紹的動畫，也是一次虛擬偶像與環境永續價值的實驗性實踐。當虛擬角色化身代言人，他們不只是數位創作，更是守護家鄉的行動者。
          </p>
          <div class="pt-2">
            <a href="https://youtu.be/to3pRejypvQ" target="_blank" rel="noopener"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#1a56a0] text-white text-sm font-semibold rounded-full hover:bg-blue-800 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              觀看影片
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 114 學年活動動態 -->
    <section class="mb-14">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">114 學年活動動態</h2>
      <div class="space-y-2">
        {events.map(e => (
          <a href={e.url} target="_blank" rel="noopener"
            class="group flex items-center gap-4 bg-white border border-gray-100 rounded-xl px-5 py-3 shadow-sm hover:shadow-md hover:border-[#1a56a0] transition-all">
            <span class="shrink-0 text-xs font-mono text-[#1a56a0] w-16">{e.date.slice(3)}</span>
            <p class="flex-1 text-sm text-gray-700 group-hover:text-[#1a56a0] transition-colors">{e.title}</p>
            <span class="text-gray-300 group-hover:text-[#1a56a0] transition-colors shrink-0 text-xs">📘 →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 活動紀錄 -->
    <section>
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-8">活動紀錄</h2>
      <div class="space-y-4">
        {posts.map(post => (
          <a href={`/blog/${post.id}`}
            class="group flex gap-5 bg-white border border-gray-100 rounded-2xl p-5 shadow-sm hover:shadow-md hover:border-[#1a56a0] transition-all">
            <div class="shrink-0 text-center w-14">
              <p class="text-xs text-gray-400">{post.data.date.getFullYear()}</p>
              <p class="text-lg font-bold text-[#1a56a0]">
                {String(post.data.date.getMonth() + 1).padStart(2, '0')}/{String(post.data.date.getDate()).padStart(2, '0')}
              </p>
            </div>
            <div class="flex-1 min-w-0 border-l border-gray-100 pl-5">
              <h2 class="font-semibold text-gray-800 text-sm leading-snug mb-2 group-hover:text-[#1a56a0] transition-colors line-clamp-2">
                {post.data.title}
              </h2>
              {post.data.tags && (
                <div class="flex flex-wrap gap-1">
                  {post.data.tags.slice(0, 3).map((tag: string) => (
                    <span class="text-xs bg-blue-50 text-[#1a56a0] px-2 py-0.5 rounded-full">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <span class="shrink-0 text-gray-300 group-hover:text-[#1a56a0] transition-colors self-center">→</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
