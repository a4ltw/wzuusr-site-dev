---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const materials = [
  { date: '2025/08/25 & 08/27', teacher: '劉榮莉 老師', topic: '《小方上學》課程講義', img: '/images/materials/chi-xiaofang.avif', url: '' },
];
---
<BaseLayout title="華文教材 — 文藻小螺絲釘 WUTH">
  <PageHero title="華文教材" subtitle="Mandarin Materials" />
  <div class="max-w-4xl mx-auto px-4 py-16">

    <section>
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">
        華語課程教材區
        <span class="text-sm font-normal text-gray-400 ml-2">Mandarin Materials of Online Education</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {materials.map(r => (
          <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            {r.img && (
              <div class="h-36 bg-gray-100 overflow-hidden">
                <img src={r.img} alt={r.topic} class="w-full h-full object-cover" loading="lazy" />
              </div>
            )}
            <div class="p-4">
              <p class="text-xs text-gray-400 mb-1">{r.date}</p>
              <p class="text-sm font-semibold text-gray-800 mb-0.5">{r.topic}</p>
              <p class="text-xs text-gray-500 mb-3">{r.teacher}</p>
              {r.url ? (
                <a href={r.url} target="_blank" rel="noopener"
                  class="inline-block px-3 py-1 bg-[#1a56a0] text-white text-xs rounded-full hover:bg-blue-800 transition-colors">
                  下載講義
                </a>
              ) : (
                <span class="inline-block px-3 py-1 bg-gray-100 text-gray-400 text-xs rounded-full">連結準備中</span>
              )}
            </div>
          </div>
        ))}
      </div>
      <p class="text-xs text-gray-400 mt-6 text-center">更多教材陸續上架中</p>
    </section>
  </div>
</BaseLayout>
