---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const works = [
  { num: 1, title: '大海裡的家（中文版）', desc: '一個關於海洋生物與環境保護的溫馨故事，引導孩子認識海洋生態。', url: 'https://reurl.cc/Gn0r6p', available: true, img: '/images/materials/anim-home-zh.avif' },
  { num: 2, title: '大海裡的家（英文版）', desc: 'A heartwarming story about ocean creatures and environmental protection.', url: 'https://youtu.be/0kyBlcUwLbY', available: true, img: '/images/materials/anim-home-en.avif' },
  { num: 3, title: '寄居蟹的時尚災難', desc: '一場從海洋傳來的無聲吶喊。透過寄居蟹尋找新家的故事，讓孩子了解海洋塑膠污染問題。', url: 'https://reurl.cc/QYAAXb', available: true, img: '/images/materials/anim-hermit.avif' },
  { num: 4, title: '我是蚵仔寮最佳代言人', desc: '以推廣蚵仔寮地方文化為目標，創作虛擬偶像「仔仔」與「蚵蚵」，結合 3D 動畫與實地拍攝，榮獲第四屆元宇宙虛擬偶像設計大賽優選獎。', url: 'https://youtu.be/to3pRejypvQ', available: true, img: '/images/materials/anim-keliao.avif' },
  { num: 5, title: 'Way Back Home（回家之路）', desc: '一段關於尋找回家道路的溫馨旅程，適合作為雙語教學素材。', url: 'https://www.youtube.com/watch?v=BDTyZYs2FbM', available: true, img: '' },
  { num: 6, title: 'Tina and Junk Monster（媞娜和垃圾食物妖怪）', desc: '透過趣味角色故事，引導孩子建立健康飲食觀念。', url: 'https://www.youtube.com/watch?v=07tUkc3fJbw', available: true, img: '' },
  { num: 7, title: 'Keep Bacteria Away（細菌滾開）', desc: '以生動故事教導孩子正確的衛生習慣，遠離細菌威脅。', url: 'https://www.youtube.com/watch?v=lvaSRgWyB_A', available: true, img: '' },
  { num: 8, title: 'My Magic Hands（你看我的手）', desc: '認識雙手的神奇用途，培養孩子的自我照護能力。', url: 'https://www.youtube.com/watch?v=hgXWzvTadyw', available: true, img: '' },
];
---
<BaseLayout title="動畫／繪本 — 文藻小螺絲釘 WUTH">
  <PageHero title="動畫／繪本" subtitle="Animation & Picture Books" />
  <div class="max-w-4xl mx-auto px-4 py-16">

    <p class="text-center text-gray-500 mb-12">
      文藻 USR 團隊師生共同創作的雙語繪本動畫，結合環保議題與語言學習，適合親子共讀與教學使用。
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {works.map(w => (
        <div class={`bg-white border rounded-2xl overflow-hidden shadow-sm ${w.available ? 'border-gray-100 hover:shadow-md transition-shadow' : 'border-dashed border-gray-200 opacity-70'}`}>
          {w.img && (
            <div class="h-36 overflow-hidden bg-gray-100">
              <img src={w.img} alt={w.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
          )}
          <div class="p-5 flex items-start gap-4">
            <div class="w-9 h-9 rounded-full bg-[#1a56a0] text-white flex items-center justify-center text-sm font-bold shrink-0">
              {w.num}
            </div>
            <div>
              <h3 class="font-bold text-gray-800 mb-1">{w.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed mb-3">{w.desc}</p>
              {w.available ? (
                <a href={w.url} target="_blank" rel="noopener"
                  class="inline-flex items-center gap-1.5 px-4 py-1.5 bg-red-500 hover:bg-red-600 text-white text-xs font-semibold rounded-full transition-colors">
                  ▶ 觀看影片
                </a>
              ) : (
                <span class="inline-block px-4 py-1.5 bg-gray-100 text-gray-400 text-xs rounded-full">影片連結待更新</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
