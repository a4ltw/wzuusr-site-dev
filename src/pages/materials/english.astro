---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const sarawak = [
  { date: '2025/04/19', teacher: '陳思羽 Sandra', topic: 'Greeting', img: '/images/materials/eng-greeting.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_fafeba52a02149c6b91001577e578acb.pdf' },
  { date: '2025/04/19 & 04/26', teacher: '蘇亭瑜 Ting Yu', topic: 'Greeting', img: '/images/materials/eng-greeting.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_08b086540ab549a2b077893a9ba88eb4.pdf' },
  { date: '2025/05/03', teacher: '楊甯宇 Olivia', topic: 'Place', img: '', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_c4659f163ff2441cb1a04e5162cbfb4b.pdf' },
  { date: '2025/05/03', teacher: '禤宇秀 Jessi', topic: 'Greetings', img: '/images/materials/eng-greeting.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_4495caf52d3b48d1bc591f7c97b6ddde.pdf' },
  { date: '2025/05/10', teacher: '楊甯宇 Olivia', topic: 'Up in the Sky', img: '/images/materials/eng-sky-olivia.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_ad77b5ecf5544cb79da355ff7c474efd.pdf' },
  { date: '2025/05/17', teacher: '陳思羽 Sandra', topic: 'Mountain', img: '/images/materials/eng-mountain-sandra.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_780028e08b2b468cbe64479b771f3f5e.pdf' },
  { date: '2025/05/24', teacher: '陳思羽 Sandra', topic: 'Sky', img: '/images/materials/eng-sky-sandra.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_ca5738ae0730438ab7ccb7c5fdf5435d.pdf' },
];

const keliao = [
  { date: '2025/04/02', topic: 'Under the Sea', img: '/images/materials/eng-under-the-sea.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_3b09883586e446199536ee1a0c5015c7.pdf' },
  { date: '2025/04/09', topic: 'Down in the Deep Blue Sea（1）', img: '/images/materials/eng-deep-blue-sea.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_9fe09297608b4d5499e41e87f2e3b4fb.pdf' },
  { date: '2025/04/09', topic: 'Down in the Deep Blue Sea（2）', img: '/images/materials/eng-deep-blue-sea.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_8b56918a60434c9aa5677e74ece372ba.pdf' },
  { date: '2025/04/23', topic: 'Save the Sea Animals from Pollutions', img: '/images/materials/eng-save-sea-animals.avif', url: '' },
  { date: '2025/04/30', topic: 'The Sea Turtle', img: '/images/materials/eng-sea-turtle.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_b63d2852b9d746148ec8390bfa2d9b78.pptx' },
  { date: '2025/05/07', topic: 'Reuse, Reduce, Recycle — 減塑環保，拯救海洋', img: '/images/materials/eng-ocean-3r.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_8a9dd42ccda84e578b03ad45c188d151.pptx' },
  { date: '2025/05/14', topic: 'Save the Sea Animals — 拯救海洋生物好朋友', img: '/images/materials/eng-save-animals-nimin.avif', url: 'https://1b3dc8e9-cde2-4647-9bfa-19f926dea93c.filesusr.com/ugd/10e09e_1396d64058d84560a4d6ddc6a0ded5d1.pdf' },
];
---
<BaseLayout title="英文教材 — 文藻小螺絲釘 WUTH">
  <PageHero title="英文教材" subtitle="English Materials" />
  <div class="max-w-4xl mx-auto px-4 py-16">

    <section class="mb-14">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">
        馬來西亞砂勞越教材專區
        <span class="text-sm font-normal text-gray-400 ml-2">Sarawak, Malaysia</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {sarawak.map(r => (
          <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            {r.img && (
              <div class="h-28 bg-gray-100 overflow-hidden">
                <img src={r.img} alt={r.topic} class="w-full h-full object-cover" loading="lazy" />
              </div>
            )}
            <div class="p-4">
              <p class="text-xs text-gray-400 mb-1">{r.date}</p>
              <p class="text-sm font-semibold text-gray-800 mb-0.5">{r.topic}</p>
              <p class="text-xs text-gray-500 mb-3">{r.teacher}</p>
              <a href={r.url} target="_blank" rel="noopener"
                class="inline-block px-3 py-1 bg-[#1a56a0] text-white text-xs rounded-full hover:bg-blue-800 transition-colors">
                下載講義
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">
        高雄市蚵寮國民小學教材專區
        <span class="text-sm font-normal text-gray-400 ml-2">海洋英文主題</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {keliao.map(r => (
          <div class="bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            {r.img && (
              <div class="h-28 bg-gray-100 overflow-hidden">
                <img src={r.img} alt={r.topic} class="w-full h-full object-cover" loading="lazy" />
              </div>
            )}
            <div class="p-4">
              <p class="text-xs text-gray-400 mb-1">{r.date}</p>
              <p class="text-sm font-semibold text-gray-800 mb-3">{r.topic}</p>
              {r.url ? (
                <a href={r.url} target="_blank" rel="noopener"
                  class="inline-block px-3 py-1 bg-[#1a56a0] text-white text-xs rounded-full hover:bg-blue-800 transition-colors">
                  下載講義
                </a>
              ) : (
                <span class="inline-block px-3 py-1 bg-gray-100 text-gray-400 text-xs rounded-full">連結準備中</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
