---
import BaseLayout from '../layouts/BaseLayout.astro';

const stats = [
  { number: '7+', label: '跨系所合作', color: 'text-[#1a56a0]' },
  { number: '3',  label: '合作醫院', color: 'text-cyan-600' },
  { number: '11+', label: '參與教師', color: 'text-blue-600' },
  { number: '100+', label: '培訓志工', color: 'text-orange-500' },
];

const features = [
  {
    title: '就醫無障礙',
    desc: '多國語國際醫療翻譯志工隊進駐區域大型醫院，共創外籍人士、新住民及移工的就醫無障礙（SDGs 3）。',
    gradient: 'from-[#1a56a0] via-blue-500 to-cyan-500',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
  {
    title: '教育陪伴',
    desc: '服務外國弱勢孩童與偏鄉學童，透過線上英文陪伴與營隊活動提升教育素養（SDGs 4）。',
    gradient: 'from-blue-500 to-cyan-600',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
  },
  {
    title: 'AI × 數位教材',
    desc: '結合 AI 科技開發動畫繪本與多語教材，用科技傳遞溫度，讓學習跨越語言的邊界。',
    gradient: 'from-orange-400 to-amber-500',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
];

const quickLinks = [
  { title: '計畫動態', desc: '最新活動與紀錄', href: '/activities', gradient: 'from-[#1a56a0] to-blue-600' },
  { title: '數位教材', desc: '動畫繪本與多語教材', href: '/materials', gradient: 'from-blue-500 to-cyan-600' },
  { title: '招生資訊', desc: '加入小螺絲釘行列', href: '/join', gradient: 'from-orange-400 to-amber-500' },
  { title: '媒體報導', desc: '看見我們的足跡', href: '/news', gradient: 'from-cyan-500 to-teal-500' },
];

---

<BaseLayout title="文藻小螺絲釘 WUTH — Wenzao USR: Tech with Heart">

  <!-- Hero：漸層底＋標語 -->
  <section class="relative overflow-hidden bg-gradient-to-br from-[#1a56a0] via-blue-600 to-cyan-500">
    <!-- 裝飾光暈 -->
    <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-cyan-300/25 blur-3xl"></div>
    <div class="absolute top-1/3 -right-20 w-80 h-80 rounded-full bg-blue-300/20 blur-3xl"></div>
    <div class="absolute -bottom-24 left-1/4 w-72 h-72 rounded-full bg-orange-300/15 blur-3xl"></div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 py-24 md:py-36 text-center">
      <p class="text-orange-300 font-semibold text-sm uppercase tracking-[0.3em] mb-5">
        Wenzao USR: Tech with Heart
      </p>
      <h1 class="text-white text-4xl md:text-6xl font-bold leading-tight mb-5">
        文藻小螺絲釘
      </h1>
      <p class="text-cyan-100 text-lg md:text-2xl mb-10 leading-relaxed">
        科技傳暖意，愛心永相續 — 用多語專業鏈結世界
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/join"
          class="px-8 py-3 bg-gradient-to-r from-orange-400 to-amber-500 text-white font-semibold rounded-full transition-all hover:scale-105 hover:shadow-2xl shadow-lg">
          加入我們
        </a>
        <a href="/about/origin"
          class="px-8 py-3 border-2 border-white/80 text-white hover:bg-white hover:text-[#1a56a0] font-semibold rounded-full transition-all">
          了解計畫
        </a>
      </div>
    </div>
  </section>

  <!-- 三大特色 -->
  <section class="py-20 px-4 max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-800 mb-12">我們在做的事</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map(f => (
        <div class="bg-white rounded-xl shadow-lg p-8 hover:shadow-xl hover:-translate-y-1 transition-all">
          <div class={`w-16 h-16 bg-gradient-to-br ${f.gradient} rounded-full flex items-center justify-center mb-5`}>
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={f.icon} />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3 text-gray-800">{f.title}</h3>
          <p class="text-gray-600 leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 計畫成果 KPI -->
  <section class="bg-gradient-to-br from-blue-50 to-cyan-50 py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-800 mb-12">計畫成果</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {stats.map(s => (
          <div>
            <div class={`text-5xl md:text-6xl font-bold ${s.color} mb-2`}>{s.number}</div>
            <div class="text-lg text-gray-700">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 快速導覽 -->
  <section class="py-20 px-4 max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-gray-800 mb-12">快速導覽</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {quickLinks.map(q => (
        <a href={q.href}
          class={`group bg-gradient-to-br ${q.gradient} rounded-xl p-6 text-white hover:shadow-2xl transition-all hover:-translate-y-1`}>
          <h3 class="text-2xl font-bold mb-2">{q.title}</h3>
          <p class="opacity-90">{q.desc}</p>
          <div class="mt-4 text-right">
            <svg class="w-6 h-6 inline-block group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-20 px-4 max-w-6xl mx-auto">
    <div class="relative overflow-hidden bg-gradient-to-r from-[#1a56a0] via-blue-500 to-cyan-500 rounded-2xl p-12 text-center text-white">
      <div class="absolute -top-10 -right-10 w-48 h-48 rounded-full bg-white/10 blur-2xl"></div>
      <h2 class="relative text-3xl md:text-4xl font-bold mb-4">
        一起成為溫暖世界的小螺絲釘
      </h2>
      <p class="relative text-lg md:text-xl mb-8 opacity-90">
        AI + 服務領導，用熱情回應世界與台灣社會的真實需求
      </p>
      <a href="/join"
        class="relative inline-block bg-white text-[#1a56a0] px-10 py-4 rounded-full font-bold text-lg hover:bg-orange-50 transition-colors shadow-lg">
        加入我們
      </a>
    </div>
  </section>

</BaseLayout>
