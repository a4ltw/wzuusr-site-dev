  },
  {
    role: '協同主持人',
    name: '林潔',
    image: '',
    current: '文藻外語大學 傳播藝術系 助理教授',
    edu: '',
    spec: '視覺文化研究、媒體研究與批評、跨文化溝通、媒體製作',
  },
  {
    role: '協同主持人',
    name: '林虹秀',
    image: '',
    current: '文藻外語大學 翻譯系 助理教授',
    edu: '',
    spec: '翻譯學、口譯實務、口譯教學',
  },
  {
    role: '協同主持人',
    name: '張純華',
    image: '',
