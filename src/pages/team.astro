];

const assistants = [
  {
    name: '劉千瑀 Chien Liu',
    image: '/images/team/liu-qianyu.jpg',
    role: '專任助理',
    current: '文藻外語大學 USR 計畫專任助理',
  },
  {
    name: '陳佳彣 Teresa Chen',
    image: '/images/team/chen-jiawen.png',
    role: '兼任助理',
    current: '文藻外語大學 國際事務系',
  },
];
---
<BaseLayout title="計畫團隊 — 文藻小螺絲釘 WUTH">
  <PageHero title="計畫團隊" subtitle="Project Team" />
  <div class="max-w-4xl mx-auto px-4 py-16">

    <!-- PI -->
    <section class="mb-14">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-8">計畫總主持人</h2>
      <div class="bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden md:flex">
        <div class="md:w-52 md:h-auto h-52 bg-gray-100 shrink-0 overflow-hidden">
          <img src="/images/team/melody.avif" alt="廖俊芳 Melody Liao"
            class="w-full h-full object-cover object-top" />
        </div>
        <div class="p-6 md:p-8">
          <p class="text-xs text-[#1a56a0] font-semibold uppercase tracking-wider mb-1">Principal Investigator</p>
          <h3 class="text-xl font-bold text-gray-800 mb-1">廖俊芳</h3>
          <p class="text-sm text-[#1a56a0] mb-1">Melody, Jun-Fang, Liao</p>
          <p class="text-xs text-gray-400 mb-4">新媒體暨管理學院 國際企業管理系 副教授</p>
          <p class="text-sm text-gray-500 leading-relaxed mb-3">
            現任文藻外語大學新媒體暨管理學院國際企業管理系暨國際事業暨國際文化交流研究所副教授。曾有 13 年任職於國際外商銀行及證券業實務工作經驗，先後任職於美國運通、花旗銀行、匯豐銀行與渣打銀行等。多次榮獲文藻「產學合作（研究）傑出獎」（2014、2016、2019）、「教學優良獎」（2018）及「私立學校教育事業協會模範教師」（2012、2017、2024）。
          </p>
          <p class="text-sm text-gray-400 italic leading-relaxed">
            Associate Professor, Dept. of International Business Management, Wenzao Ursuline University of Languages. Thirteen years of experience in international banks including American Express, Citibank, HSBC, and Standard Chartered. Recipient of the 2021 CommonWealth USR Model Award, Ministry of Education USR EXPO Best Highlight Story, and 13th Taiwan Corporate Sustainability Awards (USR Silver, 2020).
          </p>
        </div>
      </div>
    </section>

    <!-- Co-PIs -->
    <section class="mb-14">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-8">共同主持人 / 協同主持人</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {coPIs.map(m => (
          <div class="bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden flex gap-4 p-5">
            <div class="w-16 h-16 rounded-full bg-gray-100 shrink-0 overflow-hidden flex items-center justify-center">
              {m.image
                ? <img src={m.image} alt={m.name} class="w-full h-full object-cover object-top" />
                : <span class="text-2xl text-gray-300">👤</span>
              }
            </div>
            <div class="min-w-0">
              <p class="text-xs text-[#1a56a0] font-semibold mb-0.5">{m.role}</p>
              <h3 class="font-bold text-gray-800 mb-2 text-sm leading-snug">{m.name}</h3>
              <div class="space-y-1 text-xs text-gray-500">
                <p>📍 {m.current}</p>
                {m.edu && <p>🎓 {m.edu}</p>}
                {m.spec && <p>💡 {m.spec}</p>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Assistants -->
    <section>
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-8">計畫助理 / 學生助理</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {assistants.map(a => (
          <div class="bg-white border border-gray-100 rounded-xl p-4 shadow-sm text-center">
            <div class="w-16 h-16 rounded-full bg-gray-100 mx-auto mb-3 overflow-hidden flex items-center justify-center">
              {a.image
                ? <img src={a.image} alt={a.name} class="w-full h-full object-cover object-top" />
                : <span class="text-2xl text-gray-300">👤</span>
              }
            </div>
            <p class="text-xs text-[#1a56a0] font-semibold mb-0.5">{a.role}</p>
            <h3 class="text-sm font-bold text-gray-800 leading-snug">{a.name}</h3>
            <p class="text-xs text-gray-400 mt-1">{a.current}</p>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
