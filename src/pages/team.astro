---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const coPIs = [
  {
    role: '共同主持人',
    name: '蔡清華',
    image: '/images/team/tsai-qinghua.png',
    current: '文藻外語大學 外語教學系／師資培育中心 合聘講座教授',
    edu: '',
    spec: '比較教育、師資培育、教育政策、高等教育、雙語教育政策',
  },
  {
    role: '共同主持人',
    name: '藍美華 Emma Lan',
    image: '/images/team/emma.avif',
    current: '文藻外語大學 外語教學系暨外語文教事業發展研究所 副教授',
    edu: '',
    spec: '外語課程與教材設計、外語師資培訓',
  },
  {
    role: '協同主持人',
    name: '周春曉',
    image: '/images/team/zhou-chunxiao.avif',
    current: '文藻外語大學 新媒體暨管理學院 數位內容應用與管理系 專技助理教授',
    edu: '',
    spec: '多媒體與 3D 動畫、虛擬影片合成製作、動畫遊戲美術',
  },
  {
    role: '協同主持人',
    name: '吳紹慈',
    image: '',
    current: '文藻外語大學 國際事務系 助理教授',
    edu: '',
    spec: '國際企業管理、策略管理、社群媒體行銷、創新教學',
  },
  {
    role: '協同主持人',
    name: '王志堅 Marcus J.J. Wang',
    image: '/images/team/wang-zhijian.png',
    current: '文藻外語大學 吳甦樂教育中心 副教授',
    edu: '',
    spec: '自然法理論、吳經熊思想、宗教與法、人生哲學、法哲學',
  },
  {
    role: '協同主持人',
    name: '趙靜雅',
    image: '',
    current: '文藻外語大學 應用華語文系 專任助理教授',
    edu: '',
    spec: '漢語語言學、華語文教學',
  },
  {
    role: '協同主持人',
    name: '李維元',
    image: '',
    current: '文藻外語大學 通識中心 講師',
    edu: '',
    spec: '穩定同位素地球化學、環境教育、服務學習',
  },
  {
    role: '協同主持人',
    name: '謝忠志',
    image: '',
    current: '文藻外語大學 通識教育中心 專案副教授',
