---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const medical = [
  { name: '高雄榮民總醫院', since: '2016/10', logo: '/images/partners/kaohsiung-vgh.avif', desc: '與文藻僅隔幾條路有「鄰居」之稱的高雄榮民總醫院，於 2016 年 10 月 01 日與文藻外語大學結緣，並開啟許多別具意義的志工服務與執行「溫暖白色巨塔的小螺絲釘」USR 社會實踐計畫。', url: 'https://www.vghks.gov.tw/' },
  { name: '高雄市立小港醫院', since: '2019/03', logo: '/images/partners/siaogang-hospital.avif', desc: '文藻外語大學與「不凡的港醫」小港醫院相遇始於 2019 年 03 月 26 日，並協手建立的志工服務與執行「溫暖白色巨塔的小螺絲釘」USR 社會實踐計畫。', url: 'https://www.kmhk.org.tw/' },
  { name: '義大醫院', since: '2019/09', logo: '/images/partners/yida-hospital.avif', desc: '服務大量外籍移工病患，語言與文化差異造成溝通困難與服務壓力。計畫引入具多語能力之小螺絲釘學生，協助翻譯與心理支持，促進醫病理解與互動，減輕醫護壓力，提升醫療服務品質。', url: 'https://www.edah.org.tw/' },
  { name: '高雄醫學大學', since: '', logo: '/images/partners/kmu.avif', desc: '跨校合作，結合醫學專業與外語能力，共同推動國際醫療志工服務。', url: 'https://www.kmu.edu.tw/' },
];

const education = [
  { name: '旗山國小', since: '2019/09', logo: '/images/partners/qishan-school.avif', desc: '文藻外語大學與旗山國小緣起於 2019 年 09 月 01 日，並一起共創具熱情及溫暖的英語衛教營隊與執行「溫暖白色巨塔的小螺絲釘」USR 社會實踐計畫。' },
  { name: '立德國中', since: '', logo: '/images/partners/lide-school.avif', desc: '推動雙語教學與在地文化教育，讓學生拓展國際視野。' },
  { name: '蚵寮國中', since: '', logo: '/images/partners/keli-junior.png', desc: '在蔡清華次長引薦下，由芥菜種會協助媒合展開合作。偏鄉教育資源不足，學生語言能力與學習動機有待提升。團隊設計英語、AI 音樂及遊戲化課程，結合創新教材與陪伴機制，提升學生學習興趣與表達能力。' },
  { name: '蚵寮國小', since: '', logo: '/images/partners/keli-elementary.png', desc: '在蔡清華次長引薦下，由芥菜種會協助媒合展開合作。偏鄉教育資源不足，學生語言能力與學習動機有待提升。團隊設計英語、AI 音樂及遊戲化課程，結合創新教材與陪伴機制，提升學生學習興趣與表達能力。' },
  { name: '梓官赤西里、港仔門工作室', since: '', logo: '', desc: '在陳麗鈞校長引薦下，與劉英凱里長、余嘉榮老師建立連結。地方文化傳承與創新推廣力不足，青年參與有限。團隊運用 AI 與動畫技術協助地方故事數位化，帶領孩子以創意方式講述家鄉故事，培養文化自覺與表達力。' },
  { name: '梓玉生態農場', since: '', logo: '', desc: '因「為生命服務」理念契合，在芥菜種會與 TFT 牽線下展開合作。食農教育與生態永續推廣資源不足。團隊設計實作課程，結合社區資源推動食農與生態教育，培養學生環境意識與社會責任。' },
  { name: '慈惠善導書院', since: '', logo: '/images/partners/shande-temple.avif', desc: '共同推動偏鄉教育支持，培育在地文化傳承。' },
  { name: '芥菜種會', since: '', logo: '/images/partners/mustard-seed.png', desc: '計畫重要橋樑，協助團隊了解社區需求並與弱勢家庭建立連結。青年陪伴不足，弱勢家庭子女缺乏穩定教育支持。小螺絲釘團隊投入教學與陪伴，透過線上英語、創意課程與互動活動，提升孩子學習動機與自信。', url: 'https://www.mustard-seed.org.tw/' },
];

const international = [
  { name: 'Cambodia Green Umbrella KKS', since: '2019/01', logo: '/images/partners/green-umbrella-kks.png', desc: '國際非營利組織 Green Umbrella 團隊創建的私立 KKS 小學，文藻外語大學與 Green Umbrella 自 2019 年 01 月 01 日合作至今，共同展開國際志工服務並受益於更多柬埔寨當地小朋友的分享。' },
  { name: 'GlobeMed at University of Michigan', since: '2020/03', logo: '/images/partners/globemed.png', desc: '文藻國際志工在執行柬埔寨國際志工服務時，結識了志同道合的夥伴 GlobeMed at University of Michigan，並自 2020 年 03 月 02 日一起並肩前行在「服務學習」的道路上執行「溫暖白色巨塔的小螺絲釘」USR 社會實踐計畫。' },
  { name: '馬來西亞砂勞越原鄉', since: '', logo: '', desc: '與砂勞越伊班族宣教牧者乎南・笛伴牧師及芥菜種會陳芃年資深主任共同合作，探索如何為偏鄉孩童提供穩定陪伴及優質教育資源。設計結合在地文化的情境化英語課程與線上教學，提升學生語言能力與學習興趣。' },
  { name: '緬甸曼德勒兒童之家', since: '', logo: '', desc: '與芥菜種會合作推動「Train the Trainer 緬甸華語教師線上培訓計畫」，培育在地種子教師並開設線上華語課程，解決當地華語師資短缺、教育資源不足的困境。' },
];
---
<BaseLayout title="合作夥伴 — 文藻小螺絲釘 WUTH">
  <PageHero title="合作夥伴" subtitle="Partners" />
  <div class="max-w-5xl mx-auto px-4 py-16">

    <!-- 醫療夥伴 -->
    <section class="mb-14">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">🏥 醫療夥伴</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {medical.map(p => (
          <div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-4 mb-3">
              <div class="w-14 h-14 rounded-lg bg-gray-50 border border-gray-100 shrink-0 overflow-hidden flex items-center justify-center">
                {p.logo
                  ? <img src={p.logo} alt={p.name} class="w-full h-full object-contain p-1" />
                  : <span class="text-2xl">🏥</span>
                }
              </div>
              <div>
                <h3 class="font-bold text-gray-800">{p.name}</h3>
                {p.since && <span class="text-xs text-gray-400">合作自 {p.since}</span>}
              </div>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed mb-3">{p.desc}</p>
            {p.url && (
              <a href={p.url} target="_blank" rel="noopener"
                class="text-xs text-[#1a56a0] hover:underline">官方網站 →</a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 教育夥伴 -->
    <section class="mb-14">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">🏫 教育夥伴</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {education.map(p => (
          <div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-4 mb-3">
              <div class="w-14 h-14 rounded-lg bg-gray-50 border border-gray-100 shrink-0 overflow-hidden flex items-center justify-center">
                {p.logo
                  ? <img src={p.logo} alt={p.name} class="w-full h-full object-contain p-1" />
                  : <span class="text-2xl">🏫</span>
                }
              </div>
              <div>
                <h3 class="font-bold text-gray-800">{p.name}</h3>
                {p.since && <span class="text-xs text-gray-400">合作自 {p.since}</span>}
              </div>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 國際夥伴 -->
    <section>
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">🌍 國際夥伴</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {international.map(p => (
          <div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center gap-4 mb-3">
              <div class="w-14 h-14 rounded-lg bg-gray-50 border border-gray-100 shrink-0 overflow-hidden flex items-center justify-center">
                {p.logo
                  ? <img src={p.logo} alt={p.name} class="w-full h-full object-contain p-1" />
                  : <span class="text-2xl">🌍</span>
                }
              </div>
              <div>
                <h3 class="font-bold text-gray-800">{p.name}</h3>
                {p.since && <span class="text-xs text-gray-400">合作自 {p.since}</span>}
              </div>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
