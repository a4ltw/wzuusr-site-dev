---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const domains = [
  { icon: '🌐', title: '翻譯與口譯', desc: '培訓多語口譯志工，提供醫療場域的語言服務支援。' },
  { icon: '🤝', title: '跨文化溝通', desc: '教導跨文化理解與溝通技巧，提升服務品質。' },
  { icon: '🌍', title: '國際服務學習', desc: '規劃國際服務實踐，連結在地與國際需求。' },
  { icon: '📖', title: '繪本創作', desc: '指導雙語繪本製作，傳遞衛教與文化知識。' },
  { icon: '💻', title: 'AI 與數位創新', desc: '運用 AI 工具融入課程，培養學生數位能力。' },
  { icon: '🏥', title: '醫療服務學習', desc: '與醫院合作，深化學生的醫療場域實習經驗。' },
];

const recent = [
  { date: '114/03/18', title: '與 AI 共創學習體驗', speaker: '均一平台 莊哲銘（課程體驗設計專案經理）', location: 'Z1211' },
  { date: '114/04/29', title: '永續傳善：讓永續教育更有趣、更實踐！', speaker: '得勝者教育協會 沈錦秀主任 / 張雅婷組長', location: 'Z1211' },
  { date: '114/05/24', title: '團隊建立工作坊', speaker: '', location: '' },
  { date: '114/06/10', title: '跨文化的呼召——從砂勞越啟程通往南洋', speaker: '乎南・笛伴牧師 / 芥菜種會 陳芃年資深主任', location: 'Z507' },
];
---
<BaseLayout title="教師社群 — 文藻小螺絲釘 WUTH">
  <PageHero title="教師社群" subtitle="Faculty Community" />
  <div class="max-w-4xl mx-auto px-4 py-16">

    <section class="mb-12">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">教師社群活動</h2>
      <div class="text-gray-600 leading-relaxed space-y-4 text-[15px]">
        <p>感謝長期以來各位老師們的熱情參與和全力相挺！只有夥伴們透過實際行動參與，才能真正啟動按鈕，讓「文藻國際志工 USR 教師社群」持續運作，圓滿成功。我們在這裡誠摯地跟大家致謝喔！</p>
        <p>107 至 109 年 3 年間的教師社群，總共安排了 31 場次活動，邀請校內外跨域、跨界專家學者及醫師們，針對大學社會責任、專業服務學習、醫療專業服務、國際服務場域與志工現況與需求等議題進行分享交流及深入探討，除了增進夥伴們專業服務學習實務知能，也已踏出一小步跨入醫療之相關領域，更成功的為本校教師與跨領域專家學者們搭建起分享交流及深入溝通的平台，並且已啟動與合作醫療機構相互鏈結的跨域、跨專業合作。</p>
        <p>113 學年第 2 學期，我們仍將秉持「初心」持續熱情舉辦文藻國際志工 USR 教師社群活動，考量到夥伴們因為課程時段的關係，無法每場參與。因此，在多方詢問蒐集夥伴們的意見後，本學期教師社群時間將分別排定時段如下，每一場都很精彩，期盼各位夥伴的參與，並邀請更多的老師共同參與本教師社群。我們誠摯邀請您蒞臨指導，共襄盛舉！</p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">跨領域專業領域</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {domains.map(d => (
          <div class="bg-gray-50 rounded-xl p-4 text-center">
            <p class="text-2xl mb-2">{d.icon}</p>
            <h3 class="font-semibold text-gray-800 text-sm mb-1">{d.title}</h3>
            <p class="text-xs text-gray-500 leading-relaxed">{d.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-xl font-bold text-[#1a56a0] border-l-4 border-[#1a56a0] pl-4 mb-6">114 學年第 2 學期 活動紀錄</h2>
      <div class="space-y-4">
        {recent.map((r, i) => (
          <div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm flex gap-4 items-start">
            <div class="shrink-0 w-8 h-8 rounded-full bg-[#1a56a0] text-white flex items-center justify-center text-sm font-bold">{i + 1}</div>
            <div>
              <p class="text-xs text-gray-400 mb-0.5">{r.date} ・ {r.location}</p>
              <h3 class="font-semibold text-gray-800 text-sm mb-1">{r.title}</h3>
              <p class="text-xs text-gray-500">講者：{r.speaker}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
