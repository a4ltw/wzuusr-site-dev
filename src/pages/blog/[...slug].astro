---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<BaseLayout title={`${post.data.title} — 文藻小螺絲釘 WUTH`}>
  <PageHero title={post.data.title} />
  <div class="max-w-3xl mx-auto px-4 py-16">

    <div class="mb-8 flex flex-wrap items-center gap-3">
      <span class="text-sm text-gray-400">{formatDate(post.data.date)}</span>
      {post.data.tags && post.data.tags.map(tag => (
        <span class="text-xs bg-blue-50 text-[#1a56a0] px-2 py-0.5 rounded-full">{tag}</span>
      ))}
    </div>

    <div class="prose prose-gray max-w-none
      prose-headings:text-[#1a56a0] prose-headings:font-bold
      prose-a:text-[#1a56a0] prose-a:no-underline hover:prose-a:underline
      prose-img:rounded-xl prose-img:shadow-sm">
      <Content />
    </div>

    <div class="mt-12 pt-8 border-t border-gray-100">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm text-[#1a56a0] hover:underline">
        ← 回到活動部落格
      </a>
    </div>

  </div>
</BaseLayout>
